# Copy to .env.local and fill in — see docs/map-tiles.md.

# Cloudflare R2 (map tile hosting). Account ID is visible on the bucket's
# "S3 API" panel; access key/secret come from a bucket-scoped API token
# (R2 → Manage API Tokens). Only needed to run scripts/upload-map-tiles.mjs —
# the running app itself never touches these, only NEXT_PUBLIC_TILES_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public bucket URL the app actually fetches tiles from at runtime (the R2
# "Public Development URL", or a custom domain once one's set up).
NEXT_PUBLIC_TILES_BASE_URL=
