# Copy to .env.local and fill in — see docs/map-tiles.md.

# Cloudflare R2 (map tile hosting). Account ID is visible on the bucket's
# "S3 API" panel; access key/secret come from a bucket-scoped API token
# (R2 → Manage API Tokens). Only needed to run scripts/upload-map-tiles.mjs —
# the running app itself never touches these, only NEXT_PUBLIC_TILES_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public bucket URL the app actually fetches tiles from at runtime (the R2
# "Public Development URL", or a custom domain once one's set up).
NEXT_PUBLIC_TILES_BASE_URL=

# OC Transpo GTFS-RT API (realtime bus positions). Sign up for a free
# subscription at https://nextrip-public-api.developer.azure-api.net/.
# KEY_NAME is just the label you gave the subscription — informational
# only, the app doesn't read it. PRIMARY/SECONDARY are Azure API
# Management's standard key pair for zero-downtime rotation (swap which one
# the app uses, regenerate the other, swap back); the app only ever reads
# the primary key, secondary is unused for now. Sent as the
# `Ocp-Apim-Subscription-Key` header — server-side only, deliberately not
# NEXT_PUBLIC_, since it must never reach the browser bundle.
OCTRANSPO_API_KEY_NAME=
OCTRANSPO_API_PRIMARY_KEY=
OCTRANSPO_API_SECONDARY_KEY=
